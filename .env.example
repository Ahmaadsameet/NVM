# Copy to .env only if it does not already exist. Never commit .env.
# Compose pins this path to the persistent nwm-data volume.
NWM_DATABASE_PATH=/app/data/nwm.sqlite3

# Same-origin /api requests work with this blank. For a separate frontend
# origin, provide exact comma-separated origins without trailing slashes.
NWM_CORS_ORIGINS=

# Generate a private random token before using the admin endpoint.
NWM_ADMIN_TOKEN=

# Optional email notifications. Set recipient, host, username, and password.
# This application uses authenticated SMTP with STARTTLS, normally port 587.
NWM_NOTIFICATION_EMAIL=
NWM_SMTP_HOST=
NWM_SMTP_PORT=587
NWM_SMTP_USERNAME=
NWM_SMTP_PASSWORD=
# Optional: defaults to NWM_SMTP_USERNAME when blank.
NWM_SMTP_SENDER=
