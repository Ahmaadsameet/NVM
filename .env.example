# Compose port mapping and backend data path.
NWM_FRONTEND_PORT=8080
NWM_DATABASE_PATH=/app/data/nwm.sqlite3

# Public frontend origin(s), comma-separated.
NWM_CORS_ORIGINS=http://127.0.0.1:8080

# Use a long random value and keep this file private on the server.
NWM_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Optional SMTP notifications.
NWM_NOTIFICATION_EMAIL=your-recipient@example.com
NWM_SMTP_HOST=smtp.example.com
NWM_SMTP_PORT=587
NWM_SMTP_USERNAME=your-sending-account@example.com
NWM_SMTP_PASSWORD=replace-with-smtp-password
NWM_SMTP_SENDER=your-sending-account@example.com
