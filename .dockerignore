# Private configuration and credentials, including nested files and backups.
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.npmrc
**/.pypirc
**/.netrc
**/.aws
**/.ssh
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/credentials*.json
**/*service-account*.json
**/*service_account*.json

# Local data must never become an image layer or a public asset.
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.sqlite*-wal
**/*.sqlite*-shm
**/*.sqlite*-journal
**/*.db-wal
**/*.db-shm
**/*.db-journal
**/*.log
**/*.bak

# Dependencies, repository metadata, and generated artifacts.
**/.git
.gitignore
**/.venv
**/venv
**/env
**/node_modules
**/dist
**/__pycache__
**/*.pyc
**/.pytest_cache
